{
  "name": "microfluidics",
  "displayName": "Microfluidics",
  "description": "See a microfluidic chip as you write it: the chip beside its source, findings on the lines that caused them, and the flow through it.",
  "version": "0.1.0",
  "publisher": "microfluidics",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onWebviewPanel:microfluidics.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "microfluidics.openPreview",
        "title": "Microfluidics: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "microfluidics.check",
        "title": "Microfluidics: Verify That the Design Can Be Made"
      },
      {
        "command": "microfluidics.solve",
        "title": "Microfluidics: Solve the Flow"
      },
      {
        "command": "microfluidics.close",
        "title": "Microfluidics: Tune the Design Until Its Requirements Hold"
      },
      {
        "command": "microfluidics.corners",
        "title": "Microfluidics: Verify Across Fabrication Variation"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "microfluidics.openPreview",
          "when": "resourceLangId == python && microfluidics.isDesign",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Microfluidics",
      "properties": {
        "microfluidics.python": {
          "type": "string",
          "default": "",
          "description": "The Python that has the `microfluidics` package installed: a path, or a command on the PATH. Left empty, the `.venv` of the workspace folder is used, then the interpreter the Python extension is set to, then `python3`."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:vscode": "npm run build && node test/vscode/run.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "preact": "^10.24.3",
    "three": "^0.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
