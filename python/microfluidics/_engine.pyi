"""The engine: the extension module the package is built on. Its names are private to the package."""

# The ratio of two quantities of one kind is a plain number, which narrows what a quantity's
# division gives in general; the checkers are told so here and at each class.
# pyright: reportIncompatibleMethodOverride=false

from collections.abc import Callable, Iterable, Mapping, Sequence
from typing import Protocol, Self, overload

class DesignError(Exception):
    """A fault in a design: its message, and the file and line that caused it when known."""

    args: tuple[str, str | None, int | None]

class Quantity:
    """A value with a dimension. Sums need one dimension; products and quotients combine them."""

    @property
    def si(self) -> float: ...
    def __add__(self, other: Self) -> Self: ...
    def __sub__(self, other: Self) -> Self: ...
    @overload
    def __mul__(self, other: float) -> Self: ...
    @overload
    def __mul__(self, other: Quantity) -> Quantity: ...
    def __rmul__(self, other: float) -> Self: ...
    @overload
    def __truediv__(self, other: float) -> Self: ...
    @overload
    def __truediv__(self, other: Quantity) -> Quantity | float: ...
    def __rtruediv__(self, other: float) -> Quantity: ...
    def __pow__(self, exponent: int) -> Quantity: ...
    def __neg__(self) -> Self: ...
    def __abs__(self) -> Self: ...
    def __lt__(self, other: Self) -> bool: ...
    def __le__(self, other: Self) -> bool: ...
    def __gt__(self, other: Self) -> bool: ...
    def __ge__(self, other: Self) -> bool: ...
    def __hash__(self) -> int: ...

class Length(Quantity):
    # The ratio of two of one kind is a plain number: narrower than a quantity's in general.
    @overload  # type: ignore[override]
    def __truediv__(self, other: float) -> Self: ...
    @overload
    def __truediv__(self, other: Length) -> float: ...
    @overload
    def __truediv__(self, other: Quantity) -> Quantity | float: ...

