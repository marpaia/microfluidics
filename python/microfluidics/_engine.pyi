def unit(name: str) -> Quantity: ...
def parse(text: str) -> Quantity | float: ...

Value = Quantity | float
At = tuple[Length, Length]
ParamRow = tuple[str, Value, Value | None, Value | None, bool]

class Overrides:
    def __init__(self, values: Mapping[str, Value] | None = None) -> None: ...
    @staticmethod
    def parse(file: str, text: str) -> Overrides: ...
    def toml(self) -> str: ...
    def get(self, path: str) -> Value | None: ...
    def paths(self) -> list[str]: ...
    def __len__(self) -> int: ...

class Process:
    @staticmethod
    def bundled(name: str) -> Process: ...
    @staticmethod
    def parse(file: str, text: str) -> Process: ...
    @staticmethod
    def names() -> list[str]: ...
    @staticmethod
    def text(name: str) -> str | None: ...
    @property
    def name(self) -> str: ...
    @property
    def description(self) -> str: ...

class Elaborated:
    @property
    def name(self) -> str: ...
    @property
    def process(self) -> str | None: ...
    @property
    def placed(self) -> list[str]: ...
    @property
    def quantities(self) -> dict[str, float]: ...
    def tunables(self) -> list[tuple[str, Value, Value, Value, bool]]: ...
    def origins(self) -> dict[str, tuple[str, int]]: ...
    def add_source(self, name: str, text: bytes) -> None: ...
    def json(self) -> str: ...
    def fingerprint(self) -> str: ...

class Builder:
    @staticmethod
    def design(name: str, overrides: Overrides | None = None) -> Builder: ...
    def prefix(self) -> str: ...
    def rectangle(self, name: str, layer: str, start: At, end: At, file: str, line: int) -> None: ...
    def translates(
        self, name: str, layer: str, start: At, end: At, by: At, count: int, file: str, line: int
    ) -> None: ...
    def port(
        self, name: str, kind_of: str, at: At, width: Length, layer: str, faces: str, file: str, line: int
    ) -> None: ...
    def access(self, at: At, file: str, line: int) -> None: ...
    def vertex(self, name: str, file: str, line: int) -> None: ...
    def edge(self, start: str, end: str, ducts: Sequence[tuple[str, Length, Length]], file: str, line: int) -> None: ...
    def quantity(self, name: str, value: Value, file: str, line: int) -> None: ...
    def channel(
        self, name: str, layer: str, width: Length, start: str, end: str, via: Sequence[At], file: str, line: int
    ) -> None: ...
    def height(self, layer: str) -> Length | None: ...
    def settled(self, name: str) -> Value | None: ...
    def child(
        self,
        instance: str,
        name: str,
        doc: str,
        source: str,
        params: Iterable[ParamRow],
        given: Mapping[str, Value],
        file: str,
        line: int,
    ) -> Builder: ...
    def place(
        self,
        child: Builder,
        file: str,
        line: int,
        at: At | None = None,
        turned: int = 0,
        attach: str | None = None,
        to: str | None = None,
        offset: Length | None = None,
    ) -> None: ...
    def slab(self, width: Length, depth: Length, thickness: Length, file: str, line: int) -> None: ...
    def glass(self, width: Length, depth: Length, thickness: Length, file: str, line: int) -> None: ...
    def layer(self, name: str, height: Length, gds: int, file: str, line: int) -> None: ...
    def process(self, name: str, file: str, line: int) -> None: ...
    def param(
        self, name: str, value: Value, low: Value | None, high: Value | None, count: bool, file: str, line: int
    ) -> Value: ...
    def operate(
        self,
        viscosity: Viscosity,
        drives: Sequence[tuple[str, Quantity]],
        feeds: Sequence[tuple[str, Mapping[str, float]]],
        file: str,
        line: int,
    ) -> None: ...
    def require(
        self,
        name: str,
        statement: str,
        measure: tuple[str, str | None],
        subjects: Sequence[str],
        bound: tuple[str, float, float, bool],
        file: str,
        line: int,
    ) -> None: ...
    def tune(self, path: str, file: str, line: int) -> None: ...
    def own_conditions(self, on: bool) -> None: ...
    def fault(self, message: str, file: str, line: int) -> DesignError: ...
    def finish(self) -> Elaborated: ...

Build = Callable[[Overrides], Elaborated]

def beside(file: str, build: Build) -> str: ...
def verify(file: str, build: Build) -> str: ...
def close(file: str, build: Build) -> str: ...
def export(file: str, build: Build, directory: str) -> str: ...
def corners(file: str, build: Build) -> str: ...
def chip_yield(file: str, build: Build, chips: int, seed: int) -> str: ...
def solve_bias(file: str, build: Build) -> str: ...
def scene(file: str, build: Build, trial: str | None = None) -> str: ...
def keep(file: str, build: Build, values: str) -> str: ...
def benchmark(directory: str) -> str: ...
def score(directory: str, file: str, build: Build) -> str: ...
def export_wafer(file: str, directory: str, open: Callable[[str], Build]) -> str: ...

class Host(Protocol):
    """What holds a design for a session: it reads the design again, builds it, and runs a command
    on it, giving whether it passed and what it said."""

    def reload(self) -> None: ...
    def build(self, overrides: Overrides) -> Elaborated: ...
    def run(self, name: str) -> tuple[bool, str]: ...

def session(file: str, host: Host) -> None: ...
